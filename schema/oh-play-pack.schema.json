{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onlyhuman.world/oh-play/schemas/pack-v1.schema.json",
  "title": "OH Play Pack v1",
  "description": "Canonical C1 envelope for a curated OH Play Game Cards world. Schema validity is not publication or legal approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "packType",
    "version",
    "title",
    "description",
    "contributors",
    "languages",
    "rights",
    "compatibility",
    "capabilities",
    "content"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/stableId" },
    "schemaVersion": { "const": 1 },
    "packType": { "const": "game-cards-world" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contributor" }
    },
    "languages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["en", "hu"] },
      "allOf": [
        { "contains": { "const": "en" } },
        { "contains": { "const": "hu" } }
      ]
    },
    "rights": { "$ref": "#/$defs/rights" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["battle", "recognition"] }
    },
    "content": { "$ref": "#/$defs/gameCardsWorldContent" }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "hu"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "hu": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "roles"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["creator", "researcher", "translator", "illustrator"] }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentLicense", "includesThirdPartyAssets"],
      "properties": {
        "contentLicense": { "$ref": "#/$defs/license" },
        "includesThirdPartyAssets": { "type": "boolean" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameCardsEngine"],
      "properties": {
        "gameCardsEngine": { "const": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "accessedAt", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "accessedAt": { "type": "string", "format": "date" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "statDisplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["number", "approximate-number"] },
        "maximumFractionDigits": { "type": "integer", "minimum": 0, "maximum": 6 }
      }
    },
    "statDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "direction", "display"],
      "properties": {
        "key": { "$ref": "#/$defs/stableId" },
        "label": { "$ref": "#/$defs/localizedText" },
        "unit": { "$ref": "#/$defs/localizedText" },
        "direction": { "enum": ["higher-wins", "lower-wins"] },
        "display": { "$ref": "#/$defs/statDisplay" }
      }
    },
    "statValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "number" },
        "reportedRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "basis": { "$ref": "#/$defs/localizedText" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/stableId" },
        "label": { "$ref": "#/$defs/localizedText" },
        "value": { "$ref": "#/$defs/localizedText" }
      }
    },
    "assetAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "creator", "license", "modifications"],
      "properties": {
        "origin": { "enum": ["original", "third-party"] },
        "creator": { "type": "string", "minLength": 1 },
        "sourcePageUrl": { "type": "string", "format": "uri" },
        "originalFileUrl": { "type": "string", "format": "uri" },
        "originalFilename": { "type": "string", "minLength": 1 },
        "license": { "$ref": "#/$defs/license" },
        "modifications": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "accessedAt": { "type": "string", "format": "date" }
      }
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "alt", "attribution"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "alt": { "$ref": "#/$defs/localizedText" },
        "attribution": { "$ref": "#/$defs/assetAttribution" }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "cardOrder", "stats"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "cardOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "stats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/statDefinition" }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stats", "image", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display"],
          "properties": {
            "display": { "$ref": "#/$defs/localizedText" },
            "secondaryName": { "type": "string", "minLength": 1 }
          }
        },
        "summary": { "$ref": "#/$defs/localizedText" },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "stats": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/stableId" },
          "additionalProperties": { "$ref": "#/$defs/statValue" }
        },
        "image": { "$ref": "#/$defs/imageAsset" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "gameCardsWorldContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world", "cards"],
      "properties": {
        "world": { "$ref": "#/$defs/world" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card" }
        }
      }
    }
  }
}
